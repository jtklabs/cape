#!/bin/bash
# Checkmk agent plugin: emit UXI sensor piggyback data.
#
# Install on the host whose agent should carry the UXI data (usually the
# Checkmk server itself), with an execution interval to respect API limits:
#     /usr/lib/check_mk_agent/plugins/300/uxi_piggyback   (runs every 300s)
# chmod +x it. Adjust the paths/env below for your install.

export UXI_REGION="us-west"

# Credentials. Two options:
#
# (a) Hosts WITHOUT AWS access — put the client id/secret in a root-only file
#     /etc/cape/uxi.env (chmod 600, owned by root):
#         UXI_CLIENT_ID=...
#         UXI_CLIENT_SECRET=...
#     It is sourced below if present. Keep secrets out of this script so it
#     stays safe to track in git.
#
# (b) Hosts WITH AWS access — leave the file absent and use Secrets Manager:
#         export UXI_SECRET_ID="test_secrets"   # may be a shared multi-app secret
#         export AWS_REGION="us-east-1"
#     If the UXI keys in that secret aren't uxi_client_id/uxi_client_secret:
#         export UXI_CLIENT_ID_KEY="my_key_name"
#         export UXI_CLIENT_SECRET_KEY="my_other_key_name"
if [ -r /etc/cape/uxi.env ]; then
    set -a; . /etc/cape/uxi.env; set +a
fi
# Credentials for Secrets Manager come from the instance role / profile.
# If the agent runs as root without one: export AWS_PROFILE=... or key vars.

# Both may be overridden from /etc/cape/uxi.env (sourced above), so this
# script works unedited for any layout — e.g. CAPE_DIR=/data/cape when the
# code lives on a data disk and is symlinked into place.
CAPE_DIR="${CAPE_DIR:-/opt/cape}"   # directory containing the cape/ package
PYTHON="${PYTHON:-/usr/bin/python3}"

cd "$CAPE_DIR" || exit 0
# stderr (logging) must not pollute agent output
exec "$PYTHON" -m cape checkmk --host-prefix "uxi-" 2>/dev/null
